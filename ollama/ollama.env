# ollama.env — Ollama runtime configuration
#
# Read by ollama/scripts/apply-runtime-config.sh, which writes these KEY=value lines to
# ~/.homebrew/services/ollama.env (Homebrew's services env override) and restarts the service.
# Plist edits do NOT work on this Homebrew install — see ollama/docs/runtime-config-guide.md.
# Safe to re-run after any `brew services` command or `brew upgrade`.

# Metal GPU optimization — reduces memory pressure on long context
OLLAMA_FLASH_ATTENTION=1

# Halves KV cache memory vs default (fp16). Safe for coding/agentic tasks.
# Options: fp16 (default), q8_0, q4_0
OLLAMA_KV_CACHE_TYPE=q4_0

# Single request at a time — prevents context memory multiplication
OLLAMA_NUM_PARALLEL=1

# One model in memory at a time
OLLAMA_MAX_LOADED_MODELS=1

# Reserve 2 GiB of GPU/unified memory as a hard safety margin — Ollama won't
# try to use right up to the edge of what it detects as free. Added after the
# 2026-08-15 OOM incident (see docs/qwen38-memory-incident-2026-08-15.md).
OLLAMA_GPU_OVERHEAD=2147483648

# Listen on all interfaces (LAN access). Change to 127.0.0.1:11434 for local only.
OLLAMA_HOST=0.0.0.0:11434

# Keep model loaded in GPU memory for 10 hours after last request.
# Prevents model eviction during long sessions. Use 0 for infinite.
OLLAMA_KEEP_ALIVE=4h