# ollama.env — Ollama launchd runtime configuration
#
# This file is read by ollama/scripts/apply-runtime-config.sh to generate
# ~/Library/LaunchAgents/homebrew.mxcl.ollama.plist.
#
# IMPORTANT: brew services start ollama overwrites the plist with defaults.
# Re-run apply-runtime-config.sh after any brew services command.

# Metal GPU optimization — reduces memory pressure on long context
OLLAMA_FLASH_ATTENTION=1

# Halves KV cache memory vs default (fp16). Safe for coding/agentic tasks.
# Options: fp16 (default), q8_0, q4_0
OLLAMA_KV_CACHE_TYPE=q4_0

# Single request at a time — prevents context memory multiplication
OLLAMA_NUM_PARALLEL=1

# One model in memory at a time
OLLAMA_MAX_LOADED_MODELS=1

# Listen on all interfaces (LAN access). Change to 127.0.0.1:11434 for local only.
OLLAMA_HOST=0.0.0.0:11434

# Keep model loaded in GPU memory for 10 hours after last request.
# Prevents model eviction during long sessions. Use 0 for infinite.
OLLAMA_KEEP_ALIVE=4h