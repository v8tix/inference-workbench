{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "north-turbo": {
          "name": "North Turbo",
          "family": "north-mini-code",
          "limit": { "context": 32768, "output": 512 },
          "cost": { "input": 0, "output": 0 }
        },
        "north-fast": {
          "name": "North Fast",
          "family": "north-mini-code",
          "limit": { "context": 49152, "output": 1024 },
          "cost": { "input": 0, "output": 0 }
        },
        "north-standard": {
          "name": "North Standard",
          "family": "north-mini-code",
          "limit": { "context": 90112, "output": 2048 },
          "cost": { "input": 0, "output": 0 }
        },
        "north-deep": {
          "name": "North Deep",
          "family": "north-mini-code",
          "limit": { "context": 32768, "output": 4096 },
          "cost": { "input": 0, "output": 0 }
        },
        "qwen36-fast": {
          "name": "Qwen3.6 Fast",
          "family": "qwen36",
          "limit": { "context": 65536, "output": 1024 },
          "cost": { "input": 0, "output": 0 }
        },
        "qwen36-standard": {
          "name": "Qwen3.6 Standard",
          "family": "qwen36",
          "limit": { "context": 90112, "output": 2048 },
          "cost": { "input": 0, "output": 0 }
        },
        "qwen36-deep": {
          "name": "Qwen3.6 Deep",
          "family": "qwen36",
          "limit": { "context": 65536, "output": 4096 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    }
  },
  "model": "ollama/north-standard"
}
